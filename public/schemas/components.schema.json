{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://disin.vercel.app/schemas/components.schema.json",
  "title": "Disin component manifest",
  "type": "object",
  "required": ["name", "version", "compatibility", "count", "categories", "components"],
  "properties": {
    "name": { "type": "string" },
    "version": { "type": "string" },
    "compatibility": {
      "type": "object",
      "required": ["classContract", "referenceVersion", "tailwindRequired", "runtimeDependencies"]
    },
    "count": { "const": 68 },
    "categories": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 7,
      "maxItems": 7
    },
    "components": {
      "type": "array",
      "minItems": 68,
      "maxItems": 68,
      "items": {
        "type": "object",
        "required": ["id", "name", "category", "classes", "description", "css"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "category": { "type": "string" },
          "classes": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1
          },
          "description": { "type": "string" },
          "css": { "type": "string" }
        }
      }
    }
  }
}
